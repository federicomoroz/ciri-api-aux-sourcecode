# ============================================================
# Agente de Contracargos — Configuración
# Copiar a .env: cp .env.example .env
# Todas las variables usan prefijo CB_ (pydantic-settings)
# ============================================================

# ── REQUERIDOS ─────────────────────────────────────────────
# Solo necesitás estas 2 keys para arrancar.

CB_ANTHROPIC_API_KEY=sk-ant-...
# Obtener en: https://console.anthropic.com/settings/keys

CB_VOYAGE_API_KEY=pa-...
# Obtener en: https://dash.voyageai.com/ (free tier, registro en 1 min)

# ── LLM (opcionales, defaults recomendados) ───────────────

CB_LLM_MODEL=claude-haiku-4-5-20251001
# Haiku: evaluación de políticas (rápido, barato)

CB_LLM_MODEL_RESOLUTION=claude-sonnet-4-6
# Sonnet: síntesis de resolución + LLM-as-Judge (más preciso)

CB_LLM_TEMPERATURE=0.3
CB_LLM_MAX_TOKENS=4096

# ── Correrlo sin pagar: proveedores con free tier ─────────
#
# Anthropic no tiene free tier. Estos hablan el protocolo de OpenAI y regalan
# cuota suficiente para correr el dataset entero:
#
#   groq        https://console.groq.com/keys        llama-3.3-70b-versatile
#   gemini      https://aistudio.google.com/apikey   gemini-2.5-flash
#   openrouter  https://openrouter.ai/keys           ...-instruct:free
#   cerebras    https://cloud.cerebras.ai/platform   llama-3.3-70b
#   github      https://github.com/settings/tokens   gpt-4o-mini
#
# En OpenRouter solo los slugs terminados en `:free` no se cobran, y el catalogo
# rota. La lista vigente:
#   curl -s https://openrouter.ai/api/v1/models | jq -r '.data[].id' | grep ':free'
#
# ── Como se configura ─────────────────────────────────────
#
# Una clave por proveedor, en UNA variable. Es lo que conviene en un deploy
# publico: se cargan las de free tier —que no arriesgan nada— y las de pago se
# dejan afuera, para que cada visitante traiga la suya.
#
# CB_LLM_API_KEYS={"openrouter":"sk-or-v1-...","groq":"gsk_...","gemini":"AIza..."}
#
# Y el default del servidor, que es lo que usa n8n:
# CB_LLM_PROVIDER=openrouter
# CB_LLM_MODEL=openai/gpt-oss-20b:free
# CB_LLM_MODEL_RESOLUTION=openai/gpt-oss-20b:free
#
# Con eso el modo demo deja de servir informes guardados y corre el pipeline de
# verdad: no cuesta nada y el analisis es de ahora.
#
# Desde el panel, ademas, cada paso se elige por separado: «Aplicar» vale para
# esa sesion, «Guardar como predeterminado» cambia el servidor.
#
# Para un endpoint compatible que no este en la lista:
# CB_LLM_BASE_URL=https://tu-endpoint/v1
#
# OJO: los prompts estan afinados para Claude y la configuracion documentada es
# Haiku + Sonnet. Un score medido con otro proveedor NO es el score del sistema
# entregado — sirve para verificar que el pipeline no depende del proveedor.

# ── Qdrant (no tocar para Docker) ─────────────────────────

CB_QDRANT_URL=http://localhost:6333
# docker-compose.yml ya sobreescribe esto a http://qdrant:6333

# ── Seguridad (opcional) ──────────────────────────────────

CB_ADMIN_API_KEY=
# Vacío = dev mode (sin auth, ideal para evaluación local)
# Si se setea, todos los /api/* requieren header X-API-Key
# Endpoints públicos (sin auth): /panel, /api/panel/*, /health

# ── n8n (opcional) ────────────────────────────────────────

CB_N8N_BASE_URL=
# Instancia de n8n asociada al panel. Vacío = ninguna: el panel pide la URL
# en pantalla y el modo directo sigue funcionando igual.
# docker-compose ya la setea en http://n8n:5678 para el stack local.

# ── Observabilidad Langfuse (opcional) ────────────────────

CB_LANGFUSE_ENABLED=false
CB_LANGFUSE_PUBLIC_KEY=pk-lf-...
CB_LANGFUSE_SECRET_KEY=sk-lf-...
CB_LANGFUSE_HOST=https://cloud.langfuse.com

# ── Caché de informes (opcional) ──────────────────────────

CB_REPORT_CACHE_ENABLED=true

# ── Auto-mejora (opcional) ────────────────────────────────

CB_JUDGE_AUTO_INDEX_THRESHOLD=8.0
# Casos con Judge score >= 8.0 se auto-indexan como precedentes en Qdrant

# Modo demo: los casos de ejemplo se sirven ya resueltos y NO se llama al modelo,
# para que evaluar el sistema no consuma la cuenta de nadie. Quien manda su propia
# api_key en la peticion corre el pipeline completo igual. Poner false para
# ejecutar siempre de verdad con la clave del servidor.
CB_DEMO_MODE=true

# ── Rutas de datos (opcionales, defaults mostrados) ───────

CB_SQLITE_PATH=data/chargeback.db
CB_DATA_FILE_PATH=data/Similación_dataset_contracargos_.xlsx
# Informes ya generados que se sirven en modo demo. Vaciar para desactivarlo.
CB_DEMO_REPORTS_PATH=data/informes_demo

# ── Qdrant (opcionales, defaults mostrados) ───────────────

CB_QDRANT_POLICIES_COLLECTION=policies
CB_QDRANT_CASES_COLLECTION=historical_cases
# Solo hace falta con Qdrant Cloud; en local queda vacío
CB_QDRANT_API_KEY=

# ── Embeddings (opcionales, defaults mostrados) ───────────

CB_EMBEDDING_MODEL=voyage-multilingual-2
CB_EMBEDDING_DIM=1024
CB_LLM_MAX_RETRIES=2

# ── Servidor (opcionales, defaults mostrados) ─────────────

CB_HOST=0.0.0.0
CB_PORT=8000
# Path del formulario en tu n8n. Sin esto, el panel no muestra su enlace.
CB_N8N_FORM_PATH=
