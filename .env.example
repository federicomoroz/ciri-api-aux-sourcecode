# ============================================================
# Agente de Contracargos — Configuración
# Copiar a .env: cp .env.example .env
# Todas las variables usan prefijo CB_ (pydantic-settings)
# ============================================================

# ── REQUERIDOS ─────────────────────────────────────────────
# Solo necesitás estas 2 keys para arrancar.

CB_ANTHROPIC_API_KEY=sk-ant-...
# Obtener en: https://console.anthropic.com/settings/keys

CB_VOYAGE_API_KEY=pa-...
# Obtener en: https://dash.voyageai.com/ (free tier, registro en 1 min)

# ── LLM (opcionales, defaults recomendados) ───────────────

CB_LLM_MODEL=claude-haiku-4-5-20251001
# Haiku: evaluación de políticas (rápido, barato)

CB_LLM_MODEL_RESOLUTION=claude-sonnet-4-6
# Sonnet: síntesis de resolución + LLM-as-Judge (más preciso)

CB_LLM_TEMPERATURE=0.3
CB_LLM_MAX_TOKENS=4096

# ── Qdrant (no tocar para Docker) ─────────────────────────

CB_QDRANT_URL=http://localhost:6333
# docker-compose.yml ya sobreescribe esto a http://qdrant:6333

# ── Seguridad (opcional) ──────────────────────────────────

CB_ADMIN_API_KEY=
# Vacío = dev mode (sin auth, ideal para evaluación local)
# Si se setea, todos los /api/* requieren header X-API-Key
# Endpoints públicos (sin auth): /panel, /api/panel/*, /health

# ── n8n (opcional) ────────────────────────────────────────

CB_N8N_BASE_URL=
# Instancia de n8n asociada al panel. Vacío = ninguna: el panel pide la URL
# en pantalla y el modo directo sigue funcionando igual.
# docker-compose ya la setea en http://n8n:5678 para el stack local.

# ── Observabilidad Langfuse (opcional) ────────────────────

CB_LANGFUSE_ENABLED=false
CB_LANGFUSE_PUBLIC_KEY=pk-lf-...
CB_LANGFUSE_SECRET_KEY=sk-lf-...
CB_LANGFUSE_HOST=https://cloud.langfuse.com

# ── Caché semántico (opcional) ────────────────────────────

CB_SEMANTIC_CACHE_ENABLED=true
CB_SEMANTIC_CACHE_THRESHOLD=0.92

# ── Auto-mejora (opcional) ────────────────────────────────

CB_JUDGE_AUTO_INDEX_THRESHOLD=8.0
# Casos con Judge score >= 8.0 se auto-indexan como precedentes en Qdrant
