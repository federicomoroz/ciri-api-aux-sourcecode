        "jsCode": "// Cache hit: return JSON with cached flag + HTML\nconst html = $input.first().json.html;\nreturn [{ json: { cached: true, html } }];"
      },
      "id": "f38b09d8-9473-4519-a987-43d4845efc9e",
      "name": "Formatear Caché",
